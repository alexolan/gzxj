+    private fun parseCompositionAdvice(text: String): AiCompositionAdvice {
+        val cleaned = text
+            .trim()
+            .removePrefix("```json")
+            .removePrefix("```")
+            .removeSuffix("```")
+            .trim()
+        val jsonStart = cleaned.indexOf('{')
+        val jsonEnd = cleaned.lastIndexOf('}')
+        val jsonText = if (jsonStart >= 0 && jsonEnd >= jsonStart) {
+            cleaned.substring(jsonStart, jsonEnd + 1)
+        } else {
+            cleaned
+        }
+        val json = JSONObject(jsonText)
+        val score = json.optInt("score", -1).coerceAtLeast(-1)
+        if (score !in 0..100) {
+            throw IllegalArgumentException("AI composition response \"score\" was outside 0..100")
+        }
+        val tipsArray = json.optJSONArray("tips") ?: JSONArray()
+        val tips = buildList {
+            for (index in 0 until tipsArray.length()) {
+                val tip = tipsArray.optJSONObject(index) ?: continue
+                val title = tip.optString("title").trim()
+                val detail = tip.optString("detail").trim()
+                if (title.isNotEmpty() || detail.isNotEmpty()) {
+                    add(AiCompositionTip(title = title, detail = detail))
+                }
+            }
+        }
+        if (tips.isEmpty()) {
+            throw IllegalArgumentException("AI composition response contained no usable tips")
+        }
+        return AiCompositionAdvice(
+            score = score,
+            headline = json.optString("headline").trim(),
+            tips = tips.take(4),
+            highlight = json.optString("highlight").trim()
+        )
+    }
